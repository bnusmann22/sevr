# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCKS=true
CORS_ORIGINS=http://localhost:5173

# Local infrastructure credentials. Replace every change-me value before use.
POSTGRES_USER=sevr
POSTGRES_PASSWORD=change-me-postgres
